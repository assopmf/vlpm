# Données d'exécution : base SQLite, journaux WAL, sauvegardes, photos de
# constat. Ne doivent jamais partir dans le dépôt : données nominatives
# d'agents, et clichés pouvant montrer des plaques, des lieux ou des tiers.
/data/
*.db
*.db-shm
*.db-wal

# Binaires compilés
/vlpm
/vlpm-*
/dist/
*.exe

# Système
.DS_Store
Thumbs.db

# Éditeurs
.idea/
.vscode/
*.swp

# Android
/android/.gradle/
/android/build/
/android/app/build/
/android/local.properties
/android/.idea/
*.apk
*.aab
# Trousseau de signature : ne doit jamais être versionné
*.jks
*.keystore
