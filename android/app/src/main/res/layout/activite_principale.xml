<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <WebView
        android:id="@+id/vue_web"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Écran de première configuration : saisie de l'adresse du serveur. -->
    <ScrollView
        android:id="@+id/ecran_configuration"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/fond"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:padding="28dp"
            android:minHeight="400dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="@string/app_name"
                android:textColor="@color/marine"
                android:textSize="40sp"
                android:textStyle="bold"
                android:layout_marginBottom="28dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/configuration_titre"
                android:textColor="@color/texte"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/configuration_explication"
                android:textColor="@color/texte_doux"
                android:textSize="14sp"
                android:layout_marginBottom="20dp" />

            <EditText
                android:id="@+id/champ_adresse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/configuration_exemple"
                android:inputType="textUri"
                android:autofillHints="none"
                android:background="@color/blanc"
                android:padding="16dp"
                android:textSize="16sp"
                android:textColor="@color/texte"
                android:importantForAutofill="no" />

            <TextView
                android:id="@+id/message_erreur"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#991b1b"
                android:textSize="14sp"
                android:paddingTop="12dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/bouton_valider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:minHeight="52dp"
                android:text="@string/configuration_valider"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:backgroundTint="@color/marine"
                android:textColor="@color/blanc" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
